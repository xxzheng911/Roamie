require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
use_frameworks!
MIN_IOS_DEPLOYMENT_TARGET = '15.0'

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCommunityAppleSignIn', :path => '../../node_modules/@capacitor-community/apple-sign-in'
  pod 'CapacitorApp', :path => '../../node_modules/@capacitor/app'
  pod 'CapacitorBrowser', :path => '../../node_modules/@capacitor/browser'
  pod 'CapacitorCamera', :path => '../../node_modules/@capacitor/camera'
  pod 'CapacitorClipboard', :path => '../../node_modules/@capacitor/clipboard'
  pod 'CapacitorGeolocation', :path => '../../node_modules/@capacitor/geolocation'
  pod 'CapacitorKeyboard', :path => '../../node_modules/@capacitor/keyboard'
  pod 'CapacitorLocalNotifications', :path => '../../node_modules/@capacitor/local-notifications'
  pod 'CapacitorPreferences', :path => '../../node_modules/@capacitor/preferences'
  pod 'CapacitorSplashScreen', :path => '../../node_modules/@capacitor/splash-screen'
  pod 'CapacitorStatusBar', :path => '../../node_modules/@capacitor/status-bar'
  pod 'RevenuecatPurchasesCapacitor', :path => '../../node_modules/@revenuecat/purchases-capacitor'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

def mark_cp_script_phases_always_run(project)
  project.targets.each do |target|
    target.shell_script_build_phases.each do |phase|
      name = phase.name.to_s
      next unless name.include?('[CP]') || name.include?('XCFrameworks')
      phase.always_out_of_date = '1'
    end
  end
end

def suppress_third_party_build_noise(installer)
  suppress_objc_synthesis = ['CapacitorKeyboard']
  suppress_deprecated = ['Capacitor', 'CapacitorCordova']

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      if suppress_objc_synthesis.include?(target.name)
        config.build_settings['CLANG_WARN_OBJC_PROTOCOL_PROPERTY_SYNTHESIS'] = 'NO'
        config.build_settings['WARNING_CFLAGS'] ||= ['$(inherited)']
        config.build_settings['WARNING_CFLAGS'] << '-Wno-objc-protocol-property-synthesis' unless config.build_settings['WARNING_CFLAGS'].include?('-Wno-objc-protocol-property-synthesis')
      end
      if suppress_deprecated.include?(target.name)
        config.build_settings['GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS'] = 'NO'
        config.build_settings['CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS'] = 'NO'
        other_swift = config.build_settings['OTHER_SWIFT_FLAGS'] || '$(inherited)'
        config.build_settings['OTHER_SWIFT_FLAGS'] = "#{other_swift} -suppress-warnings"
      end
    end
  end

  mark_cp_script_phases_always_run(installer.pods_project)
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.native_targets.each do |target|
      target.build_configurations.each do |config|
        # Cordova CDVWebViewProcessPoolFactory.h deprecations when imported by App target.
        config.build_settings['WARNING_CFLAGS'] ||= ['$(inherited)']
        flags = config.build_settings['WARNING_CFLAGS']
        flags << '-Wno-deprecated-declarations' unless flags.include?('-Wno-deprecated-declarations')
      end
    end
    mark_cp_script_phases_always_run(aggregate_target.user_project)
  end
end

def enforce_ios_deployment_target(installer, version)
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = version
    end
  end

  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.native_targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = version
      end
    end
  end
end

# Xcode 27 / Swift 6.4 synthesizes a memberwise init(stringRepresentation:) for
# PaywallColor unless a designated init lives in the primary struct body.
# Keep RevenueCat 5.51.1 and apply the same move as purchases-ios PR #6949.
PAYWALL_COLOR_DESIGNATED_INIT_SIGNATURE = 'private init(stringRepresentation: String, underlyingColor: (any Sendable)?)'
PAYWALL_COLOR_UNPATCHED_STRUCT_TAIL = <<~'SWIFT'.freeze
    // Only available from iOS 13
    fileprivate var _underlyingColor: (any Sendable)?

}
SWIFT
PAYWALL_COLOR_PATCHED_STRUCT_TAIL = <<~'SWIFT'.freeze
    // Only available from iOS 13
    fileprivate var _underlyingColor: (any Sendable)?

    /// "Designated" initializer
    private init(stringRepresentation: String, underlyingColor: (any Sendable)?) {
        self.stringRepresentation = stringRepresentation
        self._underlyingColor = underlyingColor
    }
}
SWIFT
PAYWALL_COLOR_UNPATCHED_EXTENSION_TAIL = <<~'SWIFT'.freeze
    #endif

    /// "Designated" initializer
    private init(stringRepresentation: String, underlyingColor: (any Sendable)?) {
        self.stringRepresentation = stringRepresentation
        self._underlyingColor = underlyingColor
    }

}

// MARK: - Errors
SWIFT
PAYWALL_COLOR_PATCHED_EXTENSION_TAIL = <<~'SWIFT'.freeze
    #endif

}

// MARK: - Errors
SWIFT

def paywall_color_init_in_primary_struct?(contents)
  primary = contents.split('// MARK: - Public constructors', 2).first
  return false if primary.nil?
  primary.include?(PAYWALL_COLOR_DESIGNATED_INIT_SIGNATURE)
end

def patch_revenuecat_paywall_color_for_xcode27(installer)
  paywall_color = File.join(
    installer.sandbox.pod_dir('RevenueCat').to_s,
    'Sources',
    'Paywalls',
    'PaywallColor.swift'
  )
  unless File.exist?(paywall_color)
    raise "[Roamie] RevenueCat PaywallColor.swift not found at #{paywall_color}"
  end

  contents = File.read(paywall_color)
  in_primary = paywall_color_init_in_primary_struct?(contents)
  remainder = contents.split('// MARK: - Public constructors', 2)[1]
  if remainder.nil?
    raise "[Roamie] PaywallColor.swift is missing '// MARK: - Public constructors'; refusing to patch unknown source."
  end
  in_extension = remainder.include?(PAYWALL_COLOR_DESIGNATED_INIT_SIGNATURE)
  occurrence_count = contents.scan(PAYWALL_COLOR_DESIGNATED_INIT_SIGNATURE).length

  if in_primary && !in_extension && occurrence_count == 1
    Pod::UI.puts '[Roamie] PaywallColor Xcode 27 patch already applied; skipping.'
    return
  end

  unless !in_primary && in_extension && occurrence_count == 1
    raise "[Roamie] PaywallColor.swift is not the expected RevenueCat 5.51.1 layout " \
          "(primary=#{in_primary}, extension=#{in_extension}, count=#{occurrence_count}). " \
          "Refusing to patch unknown source."
  end

  unless contents.include?(PAYWALL_COLOR_UNPATCHED_STRUCT_TAIL)
    raise '[Roamie] PaywallColor.swift primary struct tail did not match the expected 5.51.1 pattern; refusing to patch.'
  end
  unless contents.include?(PAYWALL_COLOR_UNPATCHED_EXTENSION_TAIL)
    raise '[Roamie] PaywallColor.swift private extension tail did not match the expected 5.51.1 pattern; refusing to patch.'
  end

  patched = contents.sub(PAYWALL_COLOR_UNPATCHED_STRUCT_TAIL, PAYWALL_COLOR_PATCHED_STRUCT_TAIL)
  patched = patched.sub(PAYWALL_COLOR_UNPATCHED_EXTENSION_TAIL, PAYWALL_COLOR_PATCHED_EXTENSION_TAIL)

  unless paywall_color_init_in_primary_struct?(patched)
    raise '[Roamie] PaywallColor.swift patch failed: designated init is still missing from the primary struct.'
  end
  patched_remainder = patched.split('// MARK: - Public constructors', 2)[1]
  if patched_remainder.include?(PAYWALL_COLOR_DESIGNATED_INIT_SIGNATURE)
    raise '[Roamie] PaywallColor.swift patch failed: designated init is still present outside the primary struct.'
  end
  if patched.scan(PAYWALL_COLOR_DESIGNATED_INIT_SIGNATURE).length != 1
    raise '[Roamie] PaywallColor.swift patch failed: designated init occurrence count is not 1.'
  end

  File.chmod(0o644, paywall_color)
  File.write(paywall_color, patched)
  File.chmod(0o444, paywall_color)
  Pod::UI.puts '[Roamie] Applied Xcode 27 PaywallColor compatibility patch (purchases-ios PR #6949, RevenueCat 5.51.1).'
end

post_install do |installer|
  assertDeploymentTarget(installer)
  enforce_ios_deployment_target(installer, MIN_IOS_DEPLOYMENT_TARGET)
  suppress_third_party_build_noise(installer)
  patch_revenuecat_paywall_color_for_xcode27(installer)
end
