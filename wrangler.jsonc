{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roamie",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "ratelimits": [
    {
      "name": "GOOGLE_API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
}
