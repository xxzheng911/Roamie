{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roamie",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "version_metadata": { "binding": "WORKER_VERSION_METADATA" },
  "analytics_engine_datasets": [{ "binding": "ABUSE_GUARD_ANALYTICS", "dataset": "ABUSE_GUARD_ANALYTICS" }],
  "ratelimits": [
    {
      "name": "GOOGLE_API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "ABUSE_GUARD", "class_name": "AbuseGuard" }],
  },
  "migrations": [{ "tag": "v1-abuse-guard", "new_sqlite_classes": ["AbuseGuard"] }],
}
